# Local values are printed by `npm run db:start` (from the repo root).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only (local value from `npm run db:start`). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# Optional, server-only: publisher covers from Google Books for imported books.
# Google Cloud console → enable "Books API" → Credentials → create an API key.
# Without it, covers come from Open Library only.
GOOGLE_BOOKS_API_KEY=
