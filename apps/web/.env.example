# Local values are printed by `npm run db:start` (from the repo root).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only (local value from `npm run db:start`). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# Optional, server-only: publisher covers from Google Books for imported books.
# Google Cloud console → enable "Books API" → Credentials → create an API key.
# Without it, covers come from Open Library only.
GOOGLE_BOOKS_API_KEY=

# Optional, server-only: the NYT Best Sellers list, for the signed-out home page's pick of
# the day until Booksyde has enough readers of its own. developer.nytimes.com → sign up →
# create an app with the Books API enabled → copy its key. Without it, the pick is a classic.
NYT_BOOKS_API_KEY=

# Optional: PostHog product analytics (PostHog → Project settings → Project API key).
# Without a key, nothing is tracked. Set the host only if your project is in the EU region.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional, local only: builds the PostHog dashboard (npm run posthog:dashboard, from the repo root).
# PostHog → Settings → Personal API keys → scopes Project: Read, Dashboard: Write, Insight: Write.
# Never needed by the app itself; do not add it to Vercel.
POSTHOG_PERSONAL_API_KEY=
