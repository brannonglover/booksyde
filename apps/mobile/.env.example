# Build against what's live: use the live Supabase project's URL and publishable
# key (the same values as the web app's NEXT_PUBLIC_SUPABASE_*). For a throwaway
# local database instead, `npm run db:start` (from the repo root) prints local
# values; on a physical device, replace 127.0.0.1 with your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# The live website. The app calls it for today's pick and adding books, and links
# to it for password resets and sign-up emails. Point it at a local web server
# (http://localhost:<port>) only to try an endpoint before it's deployed; release
# builds ignore local addresses and use the live site anyway (src/lib/web-url.ts).
EXPO_PUBLIC_WEB_URL=https://www.booksyde.co
