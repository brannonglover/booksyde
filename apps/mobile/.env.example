# Local values are printed by `npm run db:start` (from the repo root).
# On a physical device, replace 127.0.0.1 with your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Where the web app runs; mobile opens it for "Forgot your password?".
EXPO_PUBLIC_WEB_URL=http://localhost:3000
